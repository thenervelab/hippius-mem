{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/illu-quality-gate.sh",
            "type": "command"
          },
          {
            "command": ".claude/hooks/illu-quality-gate-prepush.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": ".claude/hooks/illu-preflight.sh",
            "type": "command"
          },
          {
            "command": ".claude/hooks/hippius-mem-recall-preflight.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/hippius-mem-recall-token.sh",
            "type": "command"
          }
        ],
        "matcher": "mcp__hippius-mem__recall"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/hippius-mem-remember-nudge.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}
