{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/hippius-mem-recall-token.sh",
            "type": "command"
          }
        ],
        "matcher": "mcp__hippius-mem__recall|hippius-mem__recall"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/hippius-mem-recall-preflight.sh",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|MultiEdit|search_replace"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/hippius-mem-seed-nudge.sh",
            "type": "command"
          },
          {
            "command": ".claude/hooks/hippius-mem-session-brief.sh",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": ".claude/hooks/hippius-mem-remember-nudge.sh",
            "type": "command"
          }
        ]
      }
    ]
  }
}
